PORT=5200
# Supabase Configuration (Get these from your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-or-anon-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Resend Email Configuration (Get from https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=OmniTrack Alerts <onboarding@resend.dev>

# Default fallback alert recipient
DEFAULT_ALERT_EMAIL=user@example.com
